# Copy to .env and fill in. Read automatically only by `docker run --env-file`;
# for a local run export these yourself (`set -a; . ./.env; set +a`).
# A missing required variable stops the service with a message naming it.

# --- Always required -------------------------------------------------------
# Bearer token callers must present on POST /v1/execute.
EXECUTION_PROXY_TOKEN=replace-with-a-random-value
# Persistent SSH host-key file. The parent directory must be writable when
# this file does not exist yet.
SSH_KNOWN_HOSTS_FILE=./runtime/known_hosts
# Optional. Required only when a device uses private-key authentication.
#SSH_PRIVATE_KEY_DIRECTORY=./runtime/keys

# --- Inventory: pick exactly one -------------------------------------------
# (a) standalone, no NetBox
STATIC_INVENTORY_PATH=./inventory.json
# (b) NetBox: leave STATIC_INVENTORY_PATH unset and set these instead
#NETBOX_URL=https://netbox.example.com
#NETBOX_TOKEN=

# --- Credentials: pick exactly one -----------------------------------------
# (a) from the environment: one login for every device. DEVICE_USERNAME
#     selects this mode; without it a Vault is required. Lab use.
#     Exactly one of DEVICE_PASSWORD or DEVICE_PRIVATE_KEY_FILE must be
#     filled in, or the service stops at startup saying so.
DEVICE_USERNAME=diag
DEVICE_PASSWORD=
# ...or key-based instead of DEVICE_PASSWORD:
#DEVICE_PRIVATE_KEY_FILE=./id_ed25519
#DEVICE_PRIVATE_KEY_PASSPHRASE=
#DEVICE_SSH_CERTIFICATE_FILE=./id_ed25519-cert.pub

# (b) Vault over HTTP(S): leave DEVICE_USERNAME unset
#VAULT_ADDR=https://vault.example.com:8200
#VAULT_TOKEN=
# (c) local Vault Proxy Unix socket: leave DEVICE_USERNAME and VAULT_ADDR unset
#VAULT_PROXY_SOCKET_PATH=/run/vault-proxy/vault.sock

# KV v2 mount holding the credential secrets. Default: secret
#VAULT_KV_MOUNT=secret

# Maps each device's credential_profile to its KV v2 path. Vault modes only;
# without it the built-in demo profiles are used, which will not match yours.
#PROFILE_PATHS_FILE=./profile-paths.json

# --- Logging ---------------------------------------------------------------
# Audit lines are INFO; the cause behind a device_unreachable is WARNING.
#LOG_LEVEL=INFO
